# Gong API credentials
GONG_ACCESS_KEY=your_access_key_here
GONG_ACCESS_SECRET=your_access_secret_here

# Shared secret gating the HTTP endpoint. Required by api/mcp.ts — with this
# unset, the deployed endpoint refuses every request. The stdio entrypoint
# ignores it, since a local subprocess is already only reachable by you.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: per-request timeout against the Gong API, in milliseconds.
# GONG_TIMEOUT_MS=60000
