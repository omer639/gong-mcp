# Gong API credentials
GONG_ACCESS_KEY=your_access_key_here
GONG_ACCESS_SECRET=your_access_secret_here

# Master secret for the HTTP endpoint. Required — with this unset the deployed
# endpoint refuses every request and the OAuth endpoints cannot sign anything.
# It is accepted directly as a bearer token, and it is the key the OAuth
# artifacts are signed with, so rotating it invalidates every issued token.
# The stdio entrypoint ignores it, being a local subprocess already.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: the password typed on the OAuth consent screen. Defaults to
# MCP_AUTH_TOKEN, which works but means pasting 64 hex characters — including on
# a phone. Set something memorable here instead. It grants full read access to
# your Gong data, so treat it as a password, not a PIN.
# MCP_LOGIN_PASSWORD=

# Team-access roster. Gong's API key sees EVERY call in the workspace — private
# and internal ones included — and cannot be scoped per user. So the tools gate
# access here: a call is only ever exposed if a roster member took part in it
# (owner or participant). Calls no one on the roster attended — exec, HR, M&A,
# strategy — stay invisible. Set at least one of these before serving a team;
# with both unset the gate is OFF and every call the key can see is exposed.
# User IDs are the reliable match (stable, and used as a fast path for owners);
# emails are easier to maintain. Comma-separated.
# GONG_TEAM_USER_IDS=1234567890,9876543210
# GONG_TEAM_EMAILS=ae@yourco.com,sdr@yourco.com,cs@yourco.com

# Optional: per-request timeout against the Gong API, in milliseconds.
# GONG_TIMEOUT_MS=60000

# Optional: override the Gong API host. The default global host routes to the
# right cell for your credentials; set this if Gong's dashboard shows a
# company-specific host and the default does not work. Either form is accepted.
# GONG_API_BASE_URL=https://us-18795.api.gong.io
